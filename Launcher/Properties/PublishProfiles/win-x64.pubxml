<?xml version="1.0" encoding="utf-8"?>
<!--
  Published launcher artifact: one framework-dependent x64 EXE (Launcher.exe).
  The launcher assemblies, the WebView2 assemblies and the compiled translations
  are bundled inside that file. The .NET 8 Desktop Runtime x64 is a separate
  prerequisite, shipped by the separate bootstrapper package (not this profile).
  Publish with:

    dotnet publish Launcher/Launcher.csproj -p:PublishProfile=win-x64

  Output: Build/Launcher/publish/win-x64/
  The update helper copies that one EXE when the launcher runs from the published
  layout (see DeferredUpdate.Schedule). Ordinary Debug/Release builds stay
  framework-dependent and multi-file so the helper can be exercised without a
  publish; this profile is the only place single-file properties live.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Framework-dependent: the runtime is a packaged prerequisite, so the
         artifact stays small enough to ship and patch as one file. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WebView2 ships WebView2Loader.dll as a native asset. Without this the
         publish output would carry a loose runtimes/ tree next to the EXE and the
         artifact would no longer be a single file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Keep managed assemblies inside the bundle: nothing is written to %TEMP%
         at startup except the native WebView2 loader. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- No symbols file or deps/runtimeconfig JSON next to the EXE: single-file
         merges them, and a stray copy would be stale multi-file packaging. -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>..\Build\Launcher\publish\win-x64\</PublishDir>
  </PropertyGroup>
  <!-- The artifact must contain only what this publish produces. Without this a
       directory left by an older multi-file publish keeps its deps.json/
       runtimeconfig.json/PDB and the folder silently stops being a single-file
       artifact. -->
  <Target Name="ClearStalePublishOutput" BeforeTargets="PrepareForPublish">
    <!-- PublishDir can be supplied by the caller and may contain operator files. -->
    <Delete Files="$(PublishDir)/Launcher.deps.json;$(PublishDir)/Launcher.runtimeconfig.json;$(PublishDir)/Launcher.pdb;$(PublishDir)/Launcher.dll" />
  </Target>
  <!-- The WebView2 package ships loose XML documentation next to its assemblies.
       It is build-time reference material, not part of the artifact. -->
  <Target Name="RemoveWebView2XmlDocumentation" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>
  <Target Name="BuildRuntimeAwareHost" AfterTargets="PrepareForBundle">
    <PropertyGroup>
      <HostOutput>$(IntermediateOutputPath)nativehost</HostOutput>
    </PropertyGroup>
    <Exec Command="dotnet build ..\Installer\RuntimeGate\RuntimeGate.csproj -c Release -p:GateTestHooks=false" />
    <Exec Command="call NativeHost\build.cmd &quot;$(HostOutput)&quot; &quot;$([System.IO.Path]::GetDirectoryName('$(AppHostSourcePath)'))&quot; &quot;..\Build\Installer\gate\Release\Mir2RuntimeGate.exe&quot;" />
    <ItemGroup>
      <FilesToBundle Remove="@(FilesToBundle)" Condition="'%(FilesToBundle.RelativePath)' == 'Launcher.exe'" />
      <FilesToBundle Include="$(HostOutput)\Launcher.exe" RelativePath="Launcher.exe" />
    </ItemGroup>
  </Target>
</Project>
