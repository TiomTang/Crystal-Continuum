<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net8.0-windows7.0</TargetFramework><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable><AssemblyName>Launcher</AssemblyName><RootNamespace>Launcher</RootNamespace><PlatformTarget>x64</PlatformTarget><BaseOutputPath>../Build/Launcher/</BaseOutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath><AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath><ApplicationIcon>MIR2.ICO</ApplicationIcon></PropertyGroup>
<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
  <OutputPath>../Build/Launcher/Debug\</OutputPath>
</PropertyGroup>
<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
  <OutputPath>../Build/Launcher/Release\</OutputPath>
</PropertyGroup>
<ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40"/></ItemGroup>
<!-- Translations are compiled resx satellites (LauncherLocalization/LauncherStrings*.resx
     -> zh-Hans/Launcher.resources.dll), not copied JSON packs; nothing under
     LauncherLocalization is packaged as content. The single-file published artifact is
     defined by Properties/PublishProfiles/win-x64.pubxml. -->
<!-- The WebView2 package ships a WPF assembly built for net5.0 WPF that references
     WindowsBase 5.0.0.0, conflicting with the 4.0.0.0 in net8.0. The launcher only
     uses the WinForms control, so drop the unused reference. -->
<Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
  <ItemGroup>
    <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
  </ItemGroup>
</Target>
</Project>